<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.youngerier</groupId>
        <artifactId>java-codegen-toolkit</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>toolkit-mybatis-flex</artifactId>
    <name>Java Code Generation Toolkit - MyBatis-Flex</name>
    <description>MyBatis-Flex 适配层：把分页查询参数转换为带 ORDER BY 的 QueryWrapper。仅需要分页模型与统一响应体的使用方不必引入本模块。</description>

    <properties>
        <automatic.module.name>io.github.youngerier.support.mybatisflex</automatic.module.name>
    </properties>

    <dependencies>
        <!-- ============================ -->
        <!-- 必需依赖（会传递给使用方）      -->
        <!-- ============================ -->

        <!-- 分页模型与异常体系 -->
        <dependency>
            <groupId>io.github.youngerier</groupId>
            <artifactId>toolkit-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- MyBatis-Flex：本模块即其适配层 -->
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-core</artifactId>
        </dependency>

        <!-- 生成的 Repository 继承 com.mybatisflex.spring.service.impl.ServiceImpl -->
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-spring</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ============================ -->
        <!-- 测试依赖                       -->
        <!-- ============================ -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- JPMS 自动模块名：显式声明，避免退化为 jar 文件名（toolkit-core 等）。
         刻意逐模块声明而非放在父 pom：父 pom 的配置会作用于 codegen-core /
         generator-maven-plugin 等模块，而带 Automatic-Module-Name 的 jar 会让
         javadoc 插件切换到 JPMS 模块模式，破坏它们的依赖解析。 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>