<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.youngerier</groupId>
        <artifactId>java-codegen-toolkit</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>toolkit-core</artifactId>
    <name>Java Code Generation Toolkit - Core</name>
    <description>基础层：统一响应体、业务断言、异常体系、消息格式化、枚举、反射工具与分页模型。只依赖 spring-core，不引入任何 Web / ORM / 中间件依赖。</description>

    <properties>
        <automatic.module.name>io.github.youngerier.support.core</automatic.module.name>
    </properties>

    <dependencies>
        <!-- ============================ -->
        <!-- 必需依赖（会传递给使用方）      -->
        <!-- ============================ -->

        <!-- Spring 核心工具：StringUtils / CollectionUtils / 空值注解 / ConcurrentReferenceHashMap -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
        </dependency>

        <!-- Bean 校验注解（分页入参 @NotNull） -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- 日志门面（MessageFormatter 的 slf4j 风格占位符、异常体系） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- 代码增强 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ============================ -->
        <!-- 测试依赖                       -->
        <!-- ============================ -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 提供真实 MDC 实现，生产环境由使用方的日志框架（logback 等）提供 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- JPMS 自动模块名：显式声明，避免退化为 jar 文件名（toolkit-core 等）。
         刻意逐模块声明而非放在父 pom：父 pom 的配置会作用于 codegen-core /
         generator-maven-plugin 等模块，而带 Automatic-Module-Name 的 jar 会让
         javadoc 插件切换到 JPMS 模块模式，破坏它们的依赖解析。 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>