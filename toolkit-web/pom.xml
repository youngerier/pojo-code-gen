<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.youngerier</groupId>
        <artifactId>java-codegen-toolkit</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>toolkit-web</artifactId>
    <name>Java Code Generation Toolkit - Web</name>
    <description>统一 Web 错误响应：全局异常处理器、参数校验错误映射、Spring Security 401/403 处理与自动装配。需要 spring-web/webmvc；Spring Security 为可选。</description>

    <properties>
        <automatic.module.name>io.github.youngerier.support.web</automatic.module.name>
    </properties>

    <dependencies>
        <!-- ============================ -->
        <!-- 必需依赖（会传递给使用方）      -->
        <!-- ============================ -->

        <!-- Response、异常体系 -->
        <dependency>
            <groupId>io.github.youngerier</groupId>
            <artifactId>toolkit-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 异常消息解析 -->
        <dependency>
            <groupId>io.github.youngerier</groupId>
            <artifactId>toolkit-i18n</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 自动装配 WebSupportAutoConfiguration 会注册 traceIdFilter，
             因此本模块依赖 trace 以保持既有行为 -->
        <dependency>
            <groupId>io.github.youngerier</groupId>
            <artifactId>toolkit-trace</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>

        <!-- Bean 校验注解 -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- ============================ -->
        <!-- 可选集成（optional，不向使用方传递） -->
        <!-- ============================ -->

        <!-- Spring Security：仅有它存在时才装配 401/403 处理 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 自动装配（@AutoConfiguration / @ConditionalOnXxx） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Servlet API -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ============================ -->
        <!-- 测试依赖                       -->
        <!-- ============================ -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- JPMS 自动模块名：显式声明，避免退化为 jar 文件名（toolkit-core 等）。
         刻意逐模块声明而非放在父 pom：父 pom 的配置会作用于 codegen-core /
         generator-maven-plugin 等模块，而带 Automatic-Module-Name 的 jar 会让
         javadoc 插件切换到 JPMS 模块模式，破坏它们的依赖解析。 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>